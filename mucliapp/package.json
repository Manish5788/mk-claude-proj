{
    "name": "mucliapp",
    "version": "0.0.1",
    "private": true,
    "description": "mucliapp description",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "devDependencies": {
        "@sap-ux/eslint-plugin-fiori-tools": "^10.0.5",
        "@sap/ux-ui5-tooling": "1",
        "@ui5/cli": "^4.0.52",
        "@ui5/linter": "latest",
        "@wdio/cli": "^9.27.1",
        "@wdio/local-runner": "^9.27.1",
        "@wdio/mocha-framework": "^6.1.17",
        "@wdio/spec-reporter": "^9.27.1",
        "ui5-task-zipper": "^3.2.1",
        "wdio-ui5-service": "^1.5.6"
    },
    "scripts": {
        "start": "fiori run --open index.html",
        "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
        "ui5lint": "ui5lint",
        "lint": "eslint ./",
        "qunit": "fiori run --open test/unitTests.qunit.html",
        "opa5": "fiori run --open test/opaTests.qunit.html",
        "wdi5": "wdio run ./webapp/test/e2e/\\wdio.conf.js"
    }
}
